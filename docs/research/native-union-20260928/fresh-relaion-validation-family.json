              "line": 45,
              "text": "    requests = records(args.requests, REQUEST_SHA)"
            },
            {
              "line": 47,
              "text": "    with args.queries_out.open(\"x\") as query_out, args.routing_out.open(\"x\") as route_out:"
            },
            {
              "line": 48,
              "text": "        for ordinal, (request, route) in enumerate(zip(requests, primary)):"
