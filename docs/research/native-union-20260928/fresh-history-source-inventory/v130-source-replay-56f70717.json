          "line": 1,
          "text": "\"\"\"Check sealed V122 query and truth identity before production-source replay.\"\"\""
        },
        {
          "line": 12,
          "text": "def verify(queries: Path, truth: Path, evidence: Path, summary: Path) -> None:"
        },
        {
          "line": 14,
          "text": "    query_rows = [json.loads(line) for line in queries.read_text().splitlines()]"
        },
        {
          "line": 17,
          "text": "    if (expected.shape != (1000, 100) or len(query_rows) != 1000"
        },
        {
          "line": 20,
          "text": "            or baseline.get(\"query_count\") != 1000):"
        },
        {
          "line": 23,
          "text": "    for ordinal, (query, row, gold) in enumerate(zip(query_rows, evidence_rows, expected)):"
        },
        {
          "line": 24,
          "text": "        if (query.get(\"query_ordinal\") != ordinal"
        },
        {
          "line": 25,
          "text": "                or row.get(\"query_ordinal\") != ordinal"
        },
        {
          "line": 26,
          "text": "                or query.get(\"source_query_ordinal\") != 9000 + ordinal"
        },
        {
          "line": 27,
          "text": "                or row.get(\"source_query_ordinal\") != 9000 + ordinal"
        },
        {
          "line": 29,
          "text": "                or len(query.get(\"query\", [])) != 96"
        },
        {
          "line": 31,
          "text": "            raise ValueError(f\"sealed V122 query/truth mismatch at {ordinal}\")"
        },
        {
          "line": 45,
          "text": "    for name in (\"queries\", \"truth\", \"evidence\", \"summary\"):"
        },
        {
          "line": 48,
          "text": "    verify(args.queries, args.truth, args.evidence, args.summary)"
        },
        {
          "line": 49,
          "text": "    print(\"sealed V122 1000-query identity and SQ8 baseline verified\")"
        }
      ]
