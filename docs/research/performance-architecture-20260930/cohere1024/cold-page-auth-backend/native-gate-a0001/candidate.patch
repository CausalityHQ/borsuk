+    impl PageAuthority {
+        // Frozen pre-substitution verifier: keep the complete old call as the control.
+        fn verify_payload_sha2(
+            &self,
+            first_page: usize,
+            last_page: usize,
+            payload: &[u8],
+        ) -> Result<(), PageError> {
+            let range = self.byte_range(first_page, last_page)?;
+            if payload.len() != range.end - range.start {
+                return Err(PageError::InvalidResponse);
+            }
+            let row_bytes = self.record_bytes;
+            for page in first_page..=last_page {
+                let local_start = (page - first_page) * self.page_rows * row_bytes;
+                let local_stop = (page + 1).saturating_mul(self.page_rows).min(self.rows)
+                    * row_bytes
+                    - range.start;
+                if Sha256::digest(&payload[local_start..local_stop]).as_slice()
+                    != self.digests[page]
+                {
+                    return Err(PageError::HashMismatch);
+                }
+            }
+            Ok(())
+        }
+    }
+
+    fn fixture_manifest(
+        sq8: bool,
+        dimensions: usize,
+        rows: usize,
+        record_bytes: usize,
+        object: &[u8],
+    ) -> (serde_json::Value, Vec<u8>) {
+        let page_rows = if sq8 { 256 } else { 32 };
+        let sidecar = object
+            .chunks(page_rows * record_bytes)
+            .flat_map(|page| Sha256::digest(page).to_vec())
+            .collect::<Vec<_>>();
+        let object_hash = format!("{:x}", Sha256::digest(object));
+        let sidecar_hash = format!("{:x}", Sha256::digest(&sidecar));
+        let manifest = if sq8 {
+            serde_json::json!({
+                "schema":"borsuk-v115-sq8-page-authority-v2", "generation":9,
+                "rows":rows, "dimensions":dimensions, "page_rows":page_rows,
+                "object_sha256":object_hash, "page_digest_sha256":sidecar_hash,
+            })
+        } else {
+            serde_json::json!({
+                "schema":"borsuk-two-bit-plane-v3", "rows":rows, "dimensions":dimensions,
+                "seed":20260923, "record_bytes":record_bytes, "page_rows":page_rows,
+                "source_sha256":"0".repeat(64), "sq8_sha256":"1".repeat(64),
+                "source_order_sha256":"2".repeat(64), "mean_sha256":"3".repeat(64),
+                "records_sha256":object_hash, "page_digest_sha256":sidecar_hash,
+                "query_or_truth_used":false,
+            })
+        };
+        (manifest, sidecar)
+    }
+
+    fn load_fixture(
+        sq8: bool,
+        manifest: &serde_json::Value,
+        sidecar: &[u8],
+    ) -> Result<PageAuthority, PageError> {
+        let body = serde_json::to_vec(manifest).map_err(|_| PageError::InvalidManifest)?;
+        let hash = format!("{:x}", Sha256::digest(&body));
+        if sq8 {
+            PageAuthority::load(&body, &hash, sidecar)
+        } else {
+            PageAuthority::load_two_bit(&body, &hash, 9, sidecar)
+        }
+    }
+
+    fn fixture_bytes(dimensions: usize, rows: usize, record_bytes: usize) -> Vec<u8> {
+        // Authentication fixtures only; these bytes are never admitted to a scorer.
+        (0..rows * record_bytes)
+            .map(|i| ((i * 37 + i / 251 + dimensions * 11) % 256) as u8)
+            .collect()
+    }
