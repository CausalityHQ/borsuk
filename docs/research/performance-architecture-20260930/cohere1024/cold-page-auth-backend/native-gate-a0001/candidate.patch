+    #[test]
+    fn page_verifiers_match_generic_full_tail_and_boundary_rows() {
+        // Literal source record sizes include ceil(padded_D / 4), including D1/D3 tails.
+        for (dimensions, source_record_bytes) in [
+            (1, 9),
+            (3, 9),
+            (5, 10),
+            (255, 72),
+            (256, 72),
+            (257, 73),
+            (768, 200),
+            (1023, 264),
+            (1024, 264),
+            (1025, 265),
+            (4097, 1033),
+        ] {
+            for sq8 in [false, true] {
+                let page_rows = if sq8 { 256 } else { 32 };
+                let record_bytes = if sq8 {
+                    dimensions + 12
+                } else {
+                    source_record_bytes
+                };
+                for rows in [
+                    1,
+                    page_rows - 1,
+                    page_rows,
+                    page_rows + 1,
+                    2 * page_rows - 1,
+                    2 * page_rows,
+                    2 * page_rows + 1,
+                ] {
+                    let object = fixture_bytes(dimensions, rows, record_bytes);
+                    let (manifest, sidecar) =
+                        fixture_manifest(sq8, dimensions, rows, record_bytes, &object);
+                    let authority = load_fixture(sq8, &manifest, &sidecar).unwrap();
+                    let last = rows.div_ceil(page_rows) - 1;
+                    for first in 0..=last {
+                        for end in first..=last {
+                            let start_byte = first * page_rows * record_bytes;
+                            let stop_byte = ((end + 1) * page_rows).min(rows) * record_bytes;
+                            assert_eq!(authority.byte_range(first, end), Ok(start_byte..stop_byte));
+                            assert_verifiers(
+                                &authority,
+                                first,
+                                end,
+                                &object[start_byte..stop_byte],
+                                Ok(()),
+                            );
+                        }
+                    }
+                }
+            }
+        }
+    }
