+    fn page_verifiers_preserve_corruption_length_range_and_sidecar_errors() {
+        for sq8 in [false, true] {
+            let (page_rows, record_bytes) = if sq8 { (256, 1036) } else { (32, 264) };
+            let rows = 2 * page_rows + 1;
+            let object = fixture_bytes(1024, rows, record_bytes);
+            let (manifest, sidecar) = fixture_manifest(sq8, 1024, rows, record_bytes, &object);
+            let authority = load_fixture(sq8, &manifest, &sidecar).unwrap();
+            // Row 1 is an unscored cover row even when only row 0 is nominated.
+            for byte in [0, object.len() / 2, object.len() - 1, record_bytes + 7] {
+                let mut changed = object.clone();
+                changed[byte] ^= 1;
+                assert_verifiers(&authority, 0, 2, &changed, Err(PageError::HashMismatch));
+                let page = byte / (page_rows * record_bytes);
+                let range = authority.byte_range(page, page).unwrap();
+                assert_verifiers(
+                    &authority,
+                    page,
+                    page,
+                    &changed[range],
+                    Err(PageError::HashMismatch),
+                );
+            }
+            let mut changed = object.clone();
+            changed[0] ^= 1;
+            assert_verifiers(
+                &authority,
+                0,
+                2,
+                &changed[..changed.len() - 1],
+                Err(PageError::InvalidResponse),
+            );
+            changed.push(0);
+            assert_verifiers(&authority, 0, 2, &changed, Err(PageError::InvalidResponse));
+            for (first, last) in [
+                (1, 0),
+                (0, 3),
+                (3, 3),
+                (0, usize::MAX),
+                (usize::MAX, usize::MAX),
+            ] {
+                assert_verifiers(
+                    &authority,
+                    first,
+                    last,
+                    &changed,
+                    Err(PageError::InvalidRange),
+                );
+            }
+            let mut wrong_sidecar = sidecar.clone();
+            wrong_sidecar[0] ^= 1;
+            assert_eq!(
+                load_fixture(sq8, &manifest, &wrong_sidecar).err(),
+                Some(PageError::InvalidSidecar)
+            );
+            let mut repinned = manifest.clone();
+            repinned["page_digest_sha256"] =
+                serde_json::json!(format!("{:x}", Sha256::digest(&wrong_sidecar)));
+            let wrong = load_fixture(sq8, &repinned, &wrong_sidecar).unwrap();
+            assert_verifiers(&wrong, 0, 2, &object, Err(PageError::HashMismatch));
+            // A bad earlier page does not change which later ranges remain valid.
+            let tail = authority.byte_range(2, 2).unwrap();
+            assert_verifiers(&wrong, 2, 2, &object[tail], Ok(()));
+        }
+    }
