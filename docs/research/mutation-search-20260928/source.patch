+                .iter()
+                .zip(vector)
+                .map(|(&q, &v)| (f64::from(q) - f64::from(v)).powi(2))
+                .sum::<f64>() as f32;
+            offer(TwoBitMutationHit {
+                id: row.id,
+                score: squared,
+            });
