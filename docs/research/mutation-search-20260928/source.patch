+/// Logical candidate from an SQ8 base row or normalized pending FP32 put.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct TwoBitMutationHit {
+    /// Signed application ID; pending puts have no base physical ordinal.
+    pub id: i64,
