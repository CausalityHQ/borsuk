+            let candidate = HeapHit(hit);
+            if heap.len() < capacity {
+                heap.push(candidate);
+            } else if heap.peek().is_some_and(|worst| candidate < *worst) {
+                *heap.peek_mut().unwrap() = candidate;
+            }
+        };
