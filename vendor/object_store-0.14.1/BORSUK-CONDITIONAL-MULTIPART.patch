+    /// Start an atomic create-only multipart upload.
+    ///
+    /// Completion publishes the entire object only if the destination is absent at
+    /// that instant; an existing destination yields [Error::AlreadyExists].
+    /// Unlike an option on [Self::put_multipart_opts], the default implementation
+    /// refuses with [Error::NotSupported] before initiating any upload.
+    ///
+    /// Implemented for AmazonS3 (conditional completion must be enabled and supported
+    /// by the service), LocalFileSystem, and InMemory, and forwarded by this crate's
+    /// wrappers. Other implementations must opt in explicitly.
+    ///
+    /// Callers bound in-flight part sizes and concurrency as for [MultipartUpload].
+    /// InMemory retains the object's chunks in RAM; it does not allocate a second
+    /// contiguous payload on completion. No completed staging object or copy is used.
+    ///
+    /// The original [MultipartUpload] abort and failure semantics still apply:
+    /// dropping an upload does not guarantee cleanup, and a completion error or lost
+    /// response can leave a committed object. An AlreadyExists after a retry cannot
+    /// identify its writer. S3 HTTP 409 conflicts retain the client's existing
+    /// AlreadyExists mapping. S3 lifecycle cleanup and application reconciliation may
+    /// still be needed; this API promises no universal orphan-storage bound.
+    async fn put_multipart_create(
+        &self,
+        _location: &Path,
