+// Slice chunk references without coalescing the object's bytes.
+fn slice_payload(payload: &PutPayload, range: Range<usize>) -> PutPayload {
+    let mut offset = 0;
+    payload
+        .iter()
+        .filter_map(|chunk| {
+            let start = range.start.saturating_sub(offset).min(chunk.len());
+            let end = range.end.saturating_sub(offset).min(chunk.len());
+            offset += chunk.len();
+            (start < end).then(|| chunk.slice(start..end))
+        })
+        .collect()
+}
